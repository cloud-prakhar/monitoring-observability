{
  "description": "Cache Service — hit rate, key count, evictions, operation latency, and ops breakdown.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null},
          {"color": "yellow", "value": 0.5}, {"color": "green", "value": 0.8}]},
        "unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "id": 1,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Cache Hit Rate",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "rate(cache_hits_total{job=\"cache-service\"}[1m]) / (rate(cache_hits_total{job=\"cache-service\"}[1m]) + rate(cache_misses_total{job=\"cache-service\"}[1m]))",
        "legendFormat": "hit rate", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Active Keys",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "cache_keys_total{job=\"cache-service\"}", "legendFormat": "keys", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null},
          {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Total Evictions",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "cache_evictions_total{job=\"cache-service\"}", "legendFormat": "evictions", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
        "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "id": 4,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Total Operations / sec",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum(rate(cache_operations_total{job=\"cache-service\"}[1m]))",
        "legendFormat": "ops/s", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Cache Hits vs Misses (per second)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(cache_hits_total{job=\"cache-service\"}[1m])", "legendFormat": "hits/s", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(cache_misses_total{job=\"cache-service\"}[1m])", "legendFormat": "misses/s", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(cache_evictions_total{job=\"cache-service\"}[1m])", "legendFormat": "evictions/s", "refId": "C"}
      ]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Active Key Count Over Time",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "cache_keys_total{job=\"cache-service\"}", "legendFormat": "active keys", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "increase(cache_evictions_total{job=\"cache-service\"}[1m])", "legendFormat": "evictions/min", "refId": "B"}
      ]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Operations Breakdown by Type",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum by (operation) (rate(cache_operations_total{job=\"cache-service\"}[1m]))",
        "legendFormat": "{{operation}}", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Operation Latency p99 by Type",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.99, sum by (operation, le) (rate(cache_operation_duration_seconds_bucket{job=\"cache-service\"}[1m])))",
          "legendFormat": "p99 {{operation}}", "refId": "A"}
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["cache", "project-3"],
  "templating": {
    "list": [{"current": {}, "hide": 0, "includeAll": false, "label": "Data source",
      "multi": false, "name": "datasource", "options": [], "query": "prometheus",
      "refresh": 1, "regex": "", "sort": 0, "type": "datasource"}]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Cache Service",
  "uid": "cache-service",
  "version": 1
}
