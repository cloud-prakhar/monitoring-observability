{
  "description": "Combined overview — Flask Web API, Job Processor, and Cache Service. Panels show 'No data' until each project is started and connected.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100,
      "title": "Project 1 — Flask Web API", "type": "row" },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
        "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}, "id": 1,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"},
      "title": "Request Rate (req/s)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum(rate(http_requests_total{job=\"flask-web-api\"}[1m]))",
        "legendFormat": "req/s", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null},
          {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.15}]},
        "unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1}, "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"},
      "title": "Error Rate (5xx)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum(rate(http_requests_total{job=\"flask-web-api\",status_code=~\"5..\"}[1m])) / sum(rate(http_requests_total{job=\"flask-web-api\"}[1m]))",
        "legendFormat": "error %", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null},
          {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.8}]},
        "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1}, "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"},
      "title": "p95 Latency",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"flask-web-api\"}[1m])) by (le))",
        "legendFormat": "p95", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 5}, "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean","max"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Request Rate by Endpoint",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum by (endpoint) (rate(http_requests_total{job=\"flask-web-api\"}[1m]))",
        "legendFormat": "{{endpoint}}", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 5}, "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean","max"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"flask-web-api\"}[1m])) by (le))",
          "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"flask-web-api\"}[1m])) by (le))",
          "legendFormat": "p95", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"flask-web-api\"}[1m])) by (le))",
          "legendFormat": "p99", "refId": "C"}
      ]
    },

    { "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12}, "id": 200,
      "title": "Project 2 — Job Processor", "type": "row" },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 13}, "id": 201,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"},
      "title": "Queue Depth",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "job_queue_depth{job=\"job-processor\"}",
        "legendFormat": "queued", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 13}, "id": 202,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"},
      "title": "Jobs Completed (total)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "jobs_completed_total{job=\"job-processor\"}",
        "legendFormat": "completed", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null},
          {"color": "yellow", "value": 0.1}, {"color": "red", "value": 0.25}]},
        "unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 13}, "id": 203,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"},
      "title": "Failure Rate",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "rate(jobs_failed_total{job=\"job-processor\"}[5m]) / rate(jobs_submitted_total{job=\"job-processor\"}[5m])",
        "legendFormat": "failure %", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 17}, "id": 204,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Queue Depth Over Time",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "job_queue_depth{job=\"job-processor\"}", "legendFormat": "queued", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "jobs_currently_processing{job=\"job-processor\"}", "legendFormat": "processing", "refId": "B"}
      ]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 17}, "id": 205,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Job Throughput (submitted vs completed vs failed)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(jobs_submitted_total{job=\"job-processor\"}[1m])", "legendFormat": "submitted/s", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(jobs_completed_total{job=\"job-processor\"}[1m])", "legendFormat": "completed/s", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(jobs_failed_total{job=\"job-processor\"}[1m])", "legendFormat": "failed/s", "refId": "C"}
      ]
    },

    { "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24}, "id": 300,
      "title": "Project 3 — Cache Service", "type": "row" },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null},
          {"color": "yellow", "value": 0.5}, {"color": "green", "value": 0.8}]},
        "unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 25}, "id": 301,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"},
      "title": "Cache Hit Rate",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "rate(cache_hits_total{job=\"cache-service\"}[1m]) / (rate(cache_hits_total{job=\"cache-service\"}[1m]) + rate(cache_misses_total{job=\"cache-service\"}[1m]))",
        "legendFormat": "hit rate", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 25}, "id": 302,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"},
      "title": "Active Keys in Cache",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "cache_keys_total{job=\"cache-service\"}",
        "legendFormat": "keys", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 25}, "id": 303,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"},
      "title": "Total Evictions",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "cache_evictions_total{job=\"cache-service\"}",
        "legendFormat": "evictions", "refId": "A"}]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 29}, "id": 304,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean","max"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Cache Hits vs Misses (rate/s)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(cache_hits_total{job=\"cache-service\"}[1m])", "legendFormat": "hits/s", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(cache_misses_total{job=\"cache-service\"}[1m])", "legendFormat": "misses/s", "refId": "B"}
      ]
    },

    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 29}, "id": 305,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Key Count Over Time",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "cache_keys_total{job=\"cache-service\"}", "legendFormat": "active keys", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "increase(cache_evictions_total{job=\"cache-service\"}[1m])", "legendFormat": "evictions/min", "refId": "B"}
      ]
    }

  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["overview", "all-projects"],
  "templating": {
    "list": [
      { "current": {}, "hide": 0, "includeAll": false, "label": "Data source",
        "multi": false, "name": "datasource", "options": [], "query": "prometheus",
        "refresh": 1, "regex": "", "sort": 0, "type": "datasource" }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "All Projects Overview",
  "uid": "all-projects-overview",
  "version": 1
}
