{
  "description": "Flask Web API — request rate, error rate, latency percentiles, and per-endpoint breakdown.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
        "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "id": 1,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Request Rate (all endpoints)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum(rate(http_requests_total{job=\"flask-web-api\"}[1m]))", "legendFormat": "req/s", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null},
          {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.15}]},
        "unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Error Rate (5xx)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum(rate(http_requests_total{job=\"flask-web-api\",status_code=~\"5..\"}[1m])) / sum(rate(http_requests_total{job=\"flask-web-api\"}[1m]))",
        "legendFormat": "error %", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null},
          {"color": "yellow", "value": 0.3}, {"color": "red", "value": 0.8}]},
        "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "p95 Latency",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"flask-web-api\"}[1m])) by (le))",
        "legendFormat": "p95", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "id": 4,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Active Requests (in-flight)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "active_requests{job=\"flask-web-api\"}", "legendFormat": "active", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Request Rate by Endpoint",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum by (endpoint) (rate(http_requests_total{job=\"flask-web-api\"}[1m]))",
        "legendFormat": "{{endpoint}}", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"flask-web-api\"}[1m])) by (le))",
          "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"flask-web-api\"}[1m])) by (le))",
          "legendFormat": "p95", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"flask-web-api\"}[1m])) by (le))",
          "legendFormat": "p99", "refId": "C"}
      ]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Response Status Codes Over Time",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum by (status_code) (rate(http_requests_total{job=\"flask-web-api\"}[1m]))",
        "legendFormat": "HTTP {{status_code}}", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}},
      "title": "Active Requests Over Time",
      "type": "timeseries",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "active_requests{job=\"flask-web-api\"}", "legendFormat": "in-flight", "refId": "A"}]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["flask", "http", "project-1"],
  "templating": {
    "list": [{"current": {}, "hide": 0, "includeAll": false, "label": "Data source",
      "multi": false, "name": "datasource", "options": [], "query": "prometheus",
      "refresh": 1, "regex": "", "sort": 0, "type": "datasource"}]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Flask Web API",
  "uid": "flask-web-api",
  "version": 1
}
