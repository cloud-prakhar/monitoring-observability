{
  "description": "Job Processor — queue depth, throughput, failure rate, and processing time distribution.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null},
          {"color": "yellow", "value": 5}, {"color": "red", "value": 15}]},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Queue Depth",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "job_queue_depth{job=\"job-processor\"}", "legendFormat": "waiting", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Currently Processing",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "jobs_currently_processing{job=\"job-processor\"}", "legendFormat": "processing", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null},
          {"color": "yellow", "value": 0.1}, {"color": "red", "value": 0.25}]},
        "unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Failure Rate",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "rate(jobs_failed_total{job=\"job-processor\"}[5m]) / rate(jobs_submitted_total{job=\"job-processor\"}[5m])",
        "legendFormat": "failure %", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
        "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center",
        "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "Median (p50) Job Duration",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "histogram_quantile(0.50, sum(rate(job_duration_seconds_bucket{job=\"job-processor\"}[5m])) by (le))",
        "legendFormat": "p50", "refId": "A"}]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Queue Depth and Active Workers Over Time",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "job_queue_depth{job=\"job-processor\"}", "legendFormat": "queued", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "jobs_currently_processing{job=\"job-processor\"}", "legendFormat": "processing", "refId": "B"}
      ]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Throughput — Submitted / Completed / Failed (per second)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(jobs_submitted_total{job=\"job-processor\"}[1m])", "legendFormat": "submitted/s", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(jobs_completed_total{job=\"job-processor\"}[1m])", "legendFormat": "completed/s", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "rate(jobs_failed_total{job=\"job-processor\"}[1m])", "legendFormat": "failed/s", "refId": "C"}
      ]
    },
    { "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"},
        "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false},
        "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12}, "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]},
        "tooltip": {"mode": "multi", "sort": "none"}},
      "title": "Job Duration Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.50, sum(rate(job_duration_seconds_bucket{job=\"job-processor\"}[5m])) by (le))",
          "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.95, sum(rate(job_duration_seconds_bucket{job=\"job-processor\"}[5m])) by (le))",
          "legendFormat": "p95", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "histogram_quantile(0.99, sum(rate(job_duration_seconds_bucket{job=\"job-processor\"}[5m])) by (le))",
          "legendFormat": "p99", "refId": "C"}
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["job-processor", "queue", "project-2"],
  "templating": {
    "list": [{"current": {}, "hide": 0, "includeAll": false, "label": "Data source",
      "multi": false, "name": "datasource", "options": [], "query": "prometheus",
      "refresh": 1, "regex": "", "sort": 0, "type": "datasource"}]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Job Processor",
  "uid": "job-processor",
  "version": 1
}
